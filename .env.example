# OpenRFP Configuration

# Environment
OPENRFP_ENV=development
OPENRFP_DEBUG=true

# Server Settings
OPENRFP_HOST=0.0.0.0
OPENRFP_PORT=8000

# Storage
OPENRFP_DATA_DIR=./data/storage

# AI Provider Configuration (Optional - fallback to local heuristic semantic matching)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Retrieval Settings
OPENRFP_RETRIEVAL_TOP_K=5
OPENRFP_SIMILARITY_THRESHOLD=0.65

# Confidence Thresholds
OPENRFP_CONFIDENCE_GREEN=0.80
OPENRFP_CONFIDENCE_AMBER=0.50
